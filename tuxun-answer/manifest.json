{
  "manifest_version": 3,
  "name": "图寻答案助手（直接出答案）",
  "version": "1.4.0",
  "description": "图寻专用：直接读取当前街景的真实坐标并显示国家，可一键在图寻地图上打点；不需要 AI、不需要网络请求。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://tuxun.fun/*",
    "https://*.tuxun.fun/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tuxun.fun/*",
        "https://*.tuxun.fun/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://tuxun.fun/*",
        "https://*.tuxun.fun/*"
      ],
      "js": [
        "src/world-data.js",
        "src/map-anim.js",
        "src/answer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
